---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import SystemCard from '../components/SystemCard.astro';
import Contact from '../components/Contact.astro';
import Wordmark from '../components/Wordmark.astro';
import LicenseStream from '../components/LicenseStream.astro';
import { systems } from '../data/profile';
---
<BaseLayout>
  <div class="page-shell">
    <Header />
    <main id="main">
      <Hero />
      <Profile />
      <section class="section-grid" id="environment" aria-labelledby="environment-title">
        <div class="section-label"><span class="accent">02 /</span><h2 id="environment-title">Environment</h2></div>
        <div class="environment-content"><div class="systems">{systems.map((system, index) => <SystemCard system={system} index={index} />)}</div>
          <details class="system-credits">
            <summary>Logo credits</summary>
            <p>Arch Linux is a trademark of the Arch Linux project. <a href="https://archlinux.org/art/">Arch Linux artwork</a>.</p>
            <p>The Android robot is reproduced or modified from work created and shared by Google and used according to terms described in the <a href="https://creativecommons.org/licenses/by/3.0/">Creative Commons 3.0 Attribution License</a>. Android is a trademark of Google LLC.</p>
            <p>SVG paths from <a href="https://simpleicons.org/">Simple Icons</a> (CC0).</p>
          </details>
        </div>
      </section>
      <LicenseStream />
      <Contact />
    </main>
    <footer><Wordmark /><div class="footer-meta"><span>© {new Date().getFullYear()} dot1245 · <a class="footer-license" href="https://github.com/dot-1245/site/blob/main/LICENSE">AGPL-3.0</a></span><span>I use arch btw</span></div><a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a></footer>
  </div>
</BaseLayout>
