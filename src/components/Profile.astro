---
import { profile } from '../data/profile';
---
<section class="section-grid" id="identity" aria-labelledby="identity-title">
  <div class="section-label"><span class="accent">01 /</span><h2 id="identity-title">Identity</h2></div>
  <div class="identity-content">
    <p class="statement" data-reveal><span class="underlined">{profile.handle}</span><span class="accent">.</span></p>
    <div class="profile-facts">
      <div><h3>Location</h3><p>{profile.location} <span class="accent" aria-hidden="true">↗</span></p><span class="muted">{profile.region} / {profile.timezone}</span></div>
    </div>
  </div>
</section>
